{
  "name": "x-distributor",
  "version": "0.1.0",
  "description": "把 X（Twitter）帖子一键分发到抖音、小红书、即刻：自动识别图文/视频，自动填写文案并上传媒体，支持生成分享卡片图片。",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.3.5"
  },
  "devDependencies": {
    "@types/chrome": "0.0.251",
    "@types/node": "20.9.0",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "postcss": "8.4.31",
    "typescript": "5.2.2"
  },
  "manifest": {
    "name": "X 一键分发",
    "description": "把 X（Twitter）帖子一键分发到抖音、小红书、即刻：自动识别图文/视频，自动填写文案并上传媒体，支持生成分享卡片图片。",
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "storage",
      "tabs",
      "tabGroups",
      "scripting"
    ]
  }
}